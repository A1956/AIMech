# 前端数据源。开发时由 Vite 代理到 json-server。
VITE_API_BASE=/api

# 远程回答需同时启动本机服务端代理；这里只是公开开关，不放密钥。
VITE_DEEPSEEK_ENABLED=false
VITE_DEEPSEEK_TIMEOUT=30000

# —— 语音回答（默认系统神经女声，免费）——
# VITE_TTS_PROVIDER=browser | baidu | openai
# browser：优先微软晓晓等 Neural/Natural 中文女声（Edge/Windows 常见）
# baidu：百度公开 TTS（/tts-baidu 代理）
# openai：兼容 /audio/speech，由本机服务端代理代持密钥
VITE_TTS_PROVIDER=browser
VITE_TTS_VOICE=Xiaoxiao
# browser 语速建议 1.15–1.35（偏快）；baidu 用 1–9
VITE_TTS_SPEED=1.25
