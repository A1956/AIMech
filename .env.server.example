# 仅由本机 Node 服务读取；复制为 .env.server.local 后填写真实值。
# 这些变量不得改成 VITE_ 前缀，否则会暴露在浏览器构建产物中。
LLM_PROXY_PORT=3002
LLM_PROXY_ALLOWED_ORIGINS=http://127.0.0.1:5280,http://localhost:5280,http://127.0.0.1:4180,http://localhost:4180
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 仅使用兼容 OpenAI 的远程语音服务时填写；browser / baidu 模式无需填写。
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
